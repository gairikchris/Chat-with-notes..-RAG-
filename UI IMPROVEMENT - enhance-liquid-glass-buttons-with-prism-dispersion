def clean_readable_text(text: str, preserve_math: bool = True) -> str:
    if not text:
        return ""
    cleaned = re.sub(r"/(?:c|g|uni|x)[0-9A-Fa-f]+", " ", text)
    cleaned = cleaned.replace("\ufffd", " ").replace("□", " ")
    cleaned = re.sub(r"[\ue000-\uf8ff]", " ", cleaned)
    cleaned = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", " ", cleaned)

    if preserve_math:
        cleaned = re.sub(rf"[^{MATH_PRESERVED_CHARS}]", " ", cleaned)
        cleaned = re.sub(r"\s+([.,;:!?)\]])", r"\1", cleaned)
        cleaned = re.sub(r"([(\[])\s+", r"\1", cleaned)
        cleaned = re.sub(r"\s*([=+\-*/<>^×÷±≤≥≠≈→←])\s*", r" \1 ", cleaned)
    else:
        cleaned = re.sub(r"[^A-Za-z0-9\s.,;:!?()\[\]{}+\-*/=<>^_%°'\"&@#]", " ", cleaned)
        cleaned = re.sub(r"\s+([.,;:!?)\]])", r"\1", cleaned)
        cleaned = re.sub(r"([(\[])\s+", r"\1", cleaned)
        cleaned = re.sub(r"\s+", " ", cleaned)

    cleaned = re.sub(r"[ \t]+", " ", cleaned)
    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned)
    return cleaned.strip()


def extract_formulas(text: str) -> list[str]:
    if not text:
        return []
    candidates = []
    pattern = re.compile(
        r"(?:[A-Za-zτθαβγδελμωπφρσΩ0-9_()\s]{1,30}"
        r"(?:=|×|÷|±|≤|≥|≠|≈|->|√|∑|∫)"
        r"[A-Za-z0-9τθαβγδελμωπφρσΩ+\-*/^×÷±≤≥≠≈().,\s]{1,45})"
    )
    for match in pattern.findall(text):
        expr = clean_readable_text(match, preserve_math=True)
        if len(expr) >= 3 and re.search(r"[A-Za-z0-9τθαβγδελμωπφρσΩ]", expr):
            candidates.append(expr)

    seen = set()
    unique = []
    for item in candidates:
        key = re.sub(r"\s+", "", item.lower())
        if key not in seen:
            seen.add(key)
            unique.append(item)
    return unique[:6]


def is_formula_query(question: str) -> bool:
    q = question.lower()
    if re.search(r"\b(formula|equation|expression|derive|derivation|law)\b", q):
        return True
    if re.search(r"[=×÷±≤≥≠≈√∑∫^]", question):
        return True
    return False


def highlight_formulas_in_text(text: str, formulas: list[str]) -> str:
    if not text or not formulas:
        return text
    highlighted = text
    for expr in sorted(formulas, key=len, reverse=True):
        escaped = re.escape(expr)
        if re.search(escaped, highlighted):
            highlighted = re.sub(
                escaped,
                lambda m: f"<mark class='formula-glass'>{m.group(0)}</mark>",
                highlighted,
                count=2,
            )
    return highlighted


def load_manifest() -> dict:
    default = {
        "last_doc_id": None,
        "docs": {},
        "preferences": {
            "mode": MODE_CHUNKS,
            "theme": THEME_DARK,
            "use_free_local": True,
            "model_name": "gemma4:31b",
            "top_k": 4,
        },
        "saved_notes": [],
        "saved_formulas": [],
    }
    if not MANIFEST_PATH.exists():
        return default
    try:
        data = json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            data.setdefault("last_doc_id", None)
            data.setdefault("docs", {})
            data.setdefault("preferences", default["preferences"])
            data["preferences"].setdefault("mode", MODE_CHUNKS)
            data["preferences"].setdefault("theme", THEME_DARK)
            data["preferences"].setdefault("use_free_local", True)
            data["preferences"].setdefault("model_name", "gemma4:31b")
            data["preferences"].setdefault("top_k", 4)
            data.setdefault("saved_notes", [])
            data.setdefault("saved_formulas", [])
            return data
    except Exception:
        pass
    return default


def save_manifest(manifest: dict) -> None:
    MANIFEST_PATH.write_text(json.dumps(manifest, indent=2, ensure_ascii=False), encoding="utf-8")


