def create_new_session_id() -> str:
    return datetime.now().strftime("session_%Y%m%d_%H%M%S_%f")[:24]


def persist_current_session() -> None:
    messages = st.session_state.get("messages", [])
    session_id = st.session_state.get("session_id")
    if not session_id or not messages:
        return

    first_user_msg = next(
        (m.get("content", "").strip() for m in messages if m.get("role") == "user" and m.get("content", "").strip()),
        "Untitled Chat",
    )
    title = first_user_msg[:42] + ("..." if len(first_user_msg) > 42 else "")
    doc_id = st.session_state.get("active_doc_id")
    doc_name = load_manifest().get("docs", {}).get(doc_id, {}).get("filename") if doc_id else None

    data = load_sessions()
    sessions = data.get("sessions", [])
    record = {
        "session_id": session_id,
        "title": title,
        "doc_id": doc_id,
        "doc_name": doc_name,
        "updated_at": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "messages": messages,
    }
    replaced = False
    for i, item in enumerate(sessions):
        if item.get("session_id") == session_id:
            sessions[i] = record
            replaced = True
            break
    if not replaced:
        sessions.append(record)

    data["sessions"] = sessions[-40:]
    save_sessions(data)


