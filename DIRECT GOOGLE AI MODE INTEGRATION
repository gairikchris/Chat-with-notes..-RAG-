            with st.expander("Google AI Mode Link & Context"):
                if ai_c.get("summary"):
                    st.write(ai_c["summary"])
                st.markdown(f"[Open in Google Search AI Mode: '{ai_c['query']}']({ai_url})")
        if msg.get("sources"):
            with st.expander("Retrieved chunks"):
                for rank, item in enumerate(msg["sources"], start=1):
                    st.markdown(
                        f"**#{rank} — Page {item['page']} (Chunk #{item['chunk_id']})** "
                        f"| Similarity: `{item['score']:.3f}`"
                    )
                    st.write(item["text"])
                    st.divider()

placeholder_text = (
    "Ask in Google AI Mode (e.g., explain angular momentum)..."
    if active_mode == MODE_AI_MODE
    else "Summarize or ask from your PDF chunks..."
)
question = st.chat_input(placeholder_text)

if question:
    st.session_state["messages"].append({"role": "user", "content": question})
    save_chat_messages(active_id, st.session_state["messages"])
    with st.chat_message("user"):
        st.markdown(question)

    ai_mode_ctx = None
    matches = []

    with st.chat_message("assistant"):
        if active_mode == MODE_AI_MODE:
            ai_mode_ctx = fetch_google_ai_mode_context(question)
            reply = format_google_ai_mode_reply(ai_mode_ctx)
            st.markdown(reply)
            ai_url = ai_mode_ctx.get("ai_mode_url") or build_google_ai_mode_url(ai_mode_ctx["query"])
            with st.expander("Google AI Mode Link & Context"):
                if ai_mode_ctx.get("summary"):
                    st.write(ai_mode_ctx["summary"])
                st.markdown(f"[Open in Google Search AI Mode: '{ai_mode_ctx['query']}']({ai_url})")
        else:
            if chunks and vectors is not None:
                matches = search_chunks(question, chunks, vectors, top_k=top_k)
                if use_free_local or not api_key.strip():
                    reply = answer_locally_from_chunks(question, matches)
                    st.markdown(reply)
                else:
                    with st.spinner(f"Asking {model_name} using retrieved chunks..."):
                        try:
                            reply = answer_with_ollama(question, matches, api_key, model=model_name)
                            st.markdown(reply)
                        except Exception as exc:
                            reply = f"Error calling Ollama API: {exc}"
                            st.error(reply)

                with st.expander("Retrieved chunks"):
                    for rank, item in enumerate(matches, start=1):
                        st.markdown(
                            f"**#{rank} — Page {item['page']} (Chunk #{item['chunk_id']})** "
                            f"| Similarity: `{item['score']:.3f}`"
                        )
                        st.write(item["text"])
                        st.divider()
            else:
                reply = "No PDF is loaded in memory yet. Upload or fetch a PDF, or toggle to **Google AI Mode**."
                st.markdown(reply)

    st.session_state["messages"].append({
        "role": "assistant",
        "content": reply,
        "sources": matches,
        "ai_mode_ctx": ai_mode_ctx,
    })
    save_chat_messages(active_id, st.session_state["messages"])
