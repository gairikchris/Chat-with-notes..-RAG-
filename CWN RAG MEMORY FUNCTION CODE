                    manifest["last_doc_id"] = next(iter(saved_docs.keys()), None)
                save_manifest(manifest)
                if st.session_state.get("active_doc_id") == selected_doc_id:
                    st.session_state["active_doc_id"] = manifest.get("last_doc_id")
                    if st.session_state["active_doc_id"]:
                        c, v = load_pdf_from_memory(st.session_state["active_doc_id"])
                        st.session_state["chunks"] = c or []
                        st.session_state["vectors"] = v
                    else:
