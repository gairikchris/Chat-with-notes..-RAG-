                recalled["from_memory"] = True
                msgs = st.session_state.setdefault("messages", [])
                msgs.append({"role": "user", "content": f"Google AI Mode: {recalled['query']}"})
                msgs.append({
                    "role": "assistant",
                    "content": format_google_ai_mode_reply(recalled),
                    "sources": [],
                    "ai_mode_ctx": recalled,
                    "query_text": recalled["query"],
                    "no_pdf_result": False,
                })
                persist_current_session()
                st.rerun()
        with g_col2:
            if st.button("Clear Queries"):
                save_google_memory({"searches": {}})
                st.rerun()
    else:
        st.caption("No saved AI Mode searches yet.")

    st.divider()
    st.header("Saved Notes & Formulas")
    note_input = st.text_input("Remember a note / formula / fact", placeholder="e.g. τ = r × F × sin(θ)")
    if st.button("Save Note") and note_input.strip():
        clean_n = clean_readable_text(note_input, preserve_math=True)
        manifest["saved_notes"].append(clean_n)
        save_manifest(manifest)
        detected = extract_formulas(clean_n)
        if detected:
            save_formulas_to_memory(detected)
        st.rerun()
    for idx, n_text in enumerate(manifest.get("saved_notes", [])):
        c_note, c_del = st.columns([5, 1])
        c_note.caption(f"• {n_text}")
        if c_del.button("×", key=f"del_note_{idx}"):
            manifest["saved_notes"].pop(idx)
            save_manifest(manifest)
            st.rerun()

    saved_formulas = manifest.get("saved_formulas", [])
    if saved_formulas:
        st.caption("**Auto-Saved Formulas:**")
        for f_idx, f_expr in enumerate(reversed(saved_formulas[-10:])):
            f_col, f_del = st.columns([5, 1])
            f_col.markdown(f"`{f_expr}`")
            if f_del.button("×", key=f"del_formula_{f_idx}"):
                real_idx = len(saved_formulas) - 1 - f_idx
                manifest["saved_formulas"].pop(real_idx)
                save_manifest(manifest)
                st.rerun()

    st.divider()
    st.header("Settings")
    use_free_local = st.checkbox(
        "Use free local chunk summary (no API key needed)",
        value=bool(prefs.get("use_free_local", True)),
    )
    api_key = st.text_input(
        "Ollama API Key (optional)",
        value=os.environ.get("OLLAMA_API_KEY", ""),
        type="password",
        placeholder="Paste Ollama API key if you have credits...",
    )
    model_name = st.text_input("Ollama Cloud Model", value=str(prefs.get("model_name", "gemma4:31b")))
    top_k = st.slider("Top matching chunks to send", min_value=3, max_value=5, value=int(prefs.get("top_k", 4)))

    if st.button("Clear current chat"):
        st.session_state["messages"] = []
        st.rerun()

st.caption("Select Chat Mode")
if hasattr(st, "segmented_control"):
    selected_mode = st.segmented_control(
        "Mode",
        options=MODES,
        default=st.session_state["chat_mode"],
        label_visibility="collapsed",
    )
else:
    selected_mode = st.radio(
        "Mode",
        options=MODES,
        index=MODES.index(st.session_state["chat_mode"]),
        horizontal=True,
        label_visibility="collapsed",
    )

if selected_mode and selected_mode != st.session_state["chat_mode"]:
    st.session_state["chat_mode"] = selected_mode

active_mode = st.session_state["chat_mode"]

new_prefs = {
    "mode": active_mode,
    "use_free_local": use_free_local,
    "model_name": model_name,
    "top_k": top_k,
}
if new_prefs != prefs:
    manifest["preferences"] = new_prefs
    save_manifest(manifest)

uploaded_file = st.file_uploader("Upload a new PDF (auto-saved to memory)", type=["pdf"])

if uploaded_file is not None:
    file_bytes = uploaded_file.getvalue()
    doc_id = hashlib.sha256(file_bytes).hexdigest()[:12]
    if st.session_state.get("active_doc_id") != doc_id:
        if doc_id in load_manifest().get("docs", {}):
            loaded_chunks, loaded_vectors = load_pdf_from_memory(doc_id)
            if loaded_chunks is not None:
                st.session_state["active_doc_id"] = doc_id
                st.session_state["chunks"] = loaded_chunks
                st.session_state["vectors"] = loaded_vectors
                st.info(f"Loaded **{uploaded_file.name}** from memory.")
        else:
            with st.spinner("Extracting, cleaning math/text, embedding, and saving to memory..."):
                chunks = extract_and_chunk_pdf(uploaded_file, chunk_words=500, overlap_words=80)
                if chunks:
                    vectors = embed_chunks(chunks)
                    save_pdf_to_memory(doc_id, uploaded_file.name, chunks, vectors)
                    st.session_state["active_doc_id"] = doc_id
                    st.session_state["chunks"] = chunks
                    st.session_state["vectors"] = vectors
                else:
                    st.session_state["active_doc_id"] = None
                    st.session_state["chunks"] = []
                    st.session_state["vectors"] = None

chunks = st.session_state.get("chunks", [])
vectors = st.session_state.get("vectors")
active_id = st.session_state.get("active_doc_id")
active_name = load_manifest().get("docs", {}).get(active_id, {}).get("filename") if active_id else None

if active_mode == MODE_AI_MODE:
    st.info("**Google AI Mode** active — queries open directly into Google Search AI Mode (`udm=50`) and are saved to search memory.")
elif chunks and vectors is not None:
    st.success(f"**Notes Chunks Summary** mode active | PDF in memory: **{active_name or 'PDF'}** ({len(chunks)} chunks).")
else:
    st.info("Fresh session ready. Upload/fetch a PDF or switch to **Google AI Mode**.")

for msg in st.session_state.get("messages", []):
    with st.chat_message(msg["role"]):
        formulas_in_msg = msg.get("formulas") or []
        if msg["role"] == "assistant" and formulas_in_msg:
            st.markdown(highlight_formulas_in_text(msg["content"], formulas_in_msg), unsafe_allow_html=True)
            st.caption("Detected Formulas: " + " | ".join(f"`{f}`" for f in formulas_in_msg))
        else:
            st.markdown(msg["content"])

        if msg.get("ai_mode_ctx"):
            ai_c = msg["ai_mode_ctx"]
            ai_url = ai_c.get("ai_mode_url") or build_google_ai_mode_url(ai_c["query"])
            with st.expander("Google AI Mode Link & Context"):
                if ai_c.get("summary"):
                    st.write(ai_c["summary"])
                st.link_button("Google Ai mode", ai_url)
        elif msg["role"] == "assistant":
            render_google_ai_footer(
                msg.get("query_text", ""),
                no_pdf_result=bool(msg.get("no_pdf_result", False)),
            )

        if msg.get("sources"):
            with st.expander("Retrieved chunks"):
                for rank, item in enumerate(msg["sources"], start=1):
                    st.markdown(
                        f"**#{rank} — Page {item['page']} (Chunk #{item['chunk_id']})** "
                        f"| Similarity: `{item['score']:.3f}`"
                    )
                    st.write(item["text"])
                    st.divider()

placeholder_text = (
    "Ask in Google AI Mode (e.g., explain angular momentum)..."
    if active_mode == MODE_AI_MODE
    else "Summarize or ask from your PDF chunks..."
)
question = st.chat_input(placeholder_text)

if question:
    st.session_state["messages"].append({"role": "user", "content": question})
    persist_current_session()
    with st.chat_message("user"):
        st.markdown(question)

    ai_mode_ctx = None
    matches = []
    no_pdf_result = False
    detected_formulas = []

    with st.chat_message("assistant"):
        if active_mode == MODE_AI_MODE:
            ai_mode_ctx = fetch_google_ai_mode_context(question)
            reply = format_google_ai_mode_reply(ai_mode_ctx)
            detected_formulas = extract_formulas(reply + " " + question)
            if detected_formulas:
                save_formulas_to_memory(detected_formulas)
                st.markdown(highlight_formulas_in_text(reply, detected_formulas), unsafe_allow_html=True)
                st.caption("Detected Formulas: " + " | ".join(f"`{f}`" for f in detected_formulas))
            else:
                st.markdown(reply)

            ai_url = ai_mode_ctx.get("ai_mode_url") or build_google_ai_mode_url(ai_mode_ctx["query"])
            with st.expander("Google AI Mode Link & Context"):
                if ai_mode_ctx.get("summary"):
                    st.write(ai_mode_ctx["summary"])
                st.link_button("Google Ai mode", ai_url)
        else:
            if chunks and vectors is not None:
                matches = search_chunks(question, chunks, vectors, top_k=top_k)
                if use_free_local or not api_key.strip():
                    reply, no_pdf_result = answer_locally_from_chunks(question, matches)
                else:
                    with st.spinner(f"Asking {model_name} using retrieved chunks..."):
                        try:
                            reply = answer_with_ollama(question, matches, api_key, model=model_name)
                            no_pdf_result = False
                        except Exception as exc:
                            reply = f"Error calling Ollama API: {exc}"
                            no_pdf_result = True

                detected_formulas = extract_formulas(reply + (" " + question if is_formula_query(question) else ""))
                if detected_formulas:
                    save_formulas_to_memory(detected_formulas)
                    st.markdown(highlight_formulas_in_text(reply, detected_formulas), unsafe_allow_html=True)
                    st.caption("Detected Formulas: " + " | ".join(f"`{f}`" for f in detected_formulas))
                else:
                    st.markdown(reply)

                render_google_ai_footer(question, no_pdf_result=no_pdf_result)

                with st.expander("Retrieved chunks"):
                    for rank, item in enumerate(matches, start=1):
                        st.markdown(
                            f"**#{rank} — Page {item['page']} (Chunk #{item['chunk_id']})** "
                            f"| Similarity: `{item['score']:.3f}`"
                        )
                        st.write(item["text"])
                        st.divider()
            else:
                no_pdf_result = True
                reply = "There's no results in the pdf, refer Google Ai mode futher"
                detected_formulas = extract_formulas(question) if is_formula_query(question) else []
                if detected_formulas:
                    save_formulas_to_memory(detected_formulas)
                st.markdown(reply)
                render_google_ai_footer(question, no_pdf_result=True)

    st.session_state["messages"].append({
        "role": "assistant",
        "content": reply,
        "sources": matches,
        "ai_mode_ctx": ai_mode_ctx,
        "query_text": question,
        "no_pdf_result": no_pdf_result,
        "formulas": detected_formulas,
    })
    persist_current_session()
