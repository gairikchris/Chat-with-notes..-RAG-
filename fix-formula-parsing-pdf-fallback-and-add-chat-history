def normalize_search_key(query: str) -> str:
    clean_q = re.sub(r"^(?:aimode:|ai:|google:|web:|search:)\s*", "", query.strip(), flags=re.IGNORECASE).strip()
    return re.sub(r"\s+", " ", clean_q.lower())


def build_google_ai_mode_url(query: str) -> str:
    return "https://www.google.com/search?q=" + urllib.parse.quote_plus(query) + "&udm=50"


def save_pdf_to_memory(doc_id: str, filename: str, chunks: list, vectors: np.ndarray) -> None:
    chunks_path = LIBRARY_DIR / f"{doc_id}.json"
    vectors_path = LIBRARY_DIR / f"{doc_id}.npy"

    chunks_path.write_text(json.dumps(chunks, ensure_ascii=False), encoding="utf-8")
    np.save(vectors_path, vectors)

    manifest = load_manifest()
    manifest["docs"][doc_id] = {
        "doc_id": doc_id,
        "filename": filename,
        "num_chunks": len(chunks),
        "chunks_file": chunks_path.name,
        "vectors_file": vectors_path.name,
    }
    manifest["last_doc_id"] = doc_id
    save_manifest(manifest)


def load_pdf_from_memory(doc_id: str) -> tuple[list, np.ndarray] | tuple[None, None]:
    manifest = load_manifest()
    meta = manifest.get("docs", {}).get(doc_id)
    if not meta:
        return None, None

    chunks_path = LIBRARY_DIR / meta["chunks_file"]
    vectors_path = LIBRARY_DIR / meta["vectors_file"]
    if not chunks_path.exists() or not vectors_path.exists():
        return None, None

    chunks = json.loads(chunks_path.read_text(encoding="utf-8"))
    vectors = np.load(vectors_path).astype(np.float32)

    manifest["last_doc_id"] = doc_id
    save_manifest(manifest)
    return chunks, vectors


def extract_and_chunk_pdf(uploaded_file, chunk_words=500, overlap_words=80):
    reader = PdfReader(uploaded_file)
    chunks = []
    chunk_index = 1

    for page_num, page in enumerate(reader.pages, start=1):
        raw_text = clean_readable_text(page.extract_text() or "", preserve_math=True)
        words = raw_text.split()
        if not words:
            continue

        step = max(1, chunk_words - overlap_words)
        for start in range(0, len(words), step):
            window = words[start : start + chunk_words]
            if not window:
                break

            chunks.append({
                "chunk_id": chunk_index,
                "page": page_num,
                "word_count": len(window),
                "text": clean_readable_text(" ".join(window), preserve_math=True),
            })
            chunk_index += 1

            if start + chunk_words >= len(words):
                break

    return chunks


def embed_chunks(chunks):
    texts = [c["text"] for c in chunks]
    vectors = embedder.encode(texts, normalize_embeddings=True, show_progress_bar=False)
    return np.asarray(vectors, dtype=np.float32)


def search_chunks(query, chunks, chunk_vectors, top_k=4):
    top_k = max(3, min(5, int(top_k)))
    query_vec = embedder.encode([query], normalize_embeddings=True, show_progress_bar=False)[0]
    scores = np.dot(chunk_vectors, query_vec)
    top_indices = np.argsort(scores)[::-1][:top_k]

    return [
        {
            "chunk_id": chunks[idx]["chunk_id"],
            "page": chunks[idx]["page"],
            "score": float(scores[idx]),
            "text": chunks[idx]["text"],
        }
        for idx in top_indices
    ]


def fetch_google_ai_mode_context(query: str, force_refresh: bool = False) -> dict:
    clean_q = re.sub(r"^(?:aimode:|ai:|google:|web:|search:)\s*", "", query.strip(), flags=re.IGNORECASE).strip()
    search_key = normalize_search_key(clean_q)
    ai_mode_url = build_google_ai_mode_url(clean_q)

    memory = load_google_memory()
    cached = memory["searches"].get(search_key)
    if cached and not force_refresh:
        result = dict(cached)
        result["ai_mode_url"] = build_google_ai_mode_url(result.get("query", clean_q))
        result["from_memory"] = True
        return result

    ddg_url = (
        "https://api.duckduckgo.com/?q="
        + urllib.parse.quote_plus(clean_q)
        + "&format=json&no_html=1&skip_disambig=1"
    )
    summary = ""
    source_name = "Google Search AI Mode"

    try:
        req = urllib.request.Request(ddg_url, headers={"User-Agent": "ChatWithYourNotes/1.0"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        summary = (
            data.get("AbstractText")
            or data.get("Answer")
            or data.get("Definition")
            or ""
        ).strip()
        if not summary and isinstance(data.get("RelatedTopics"), list):
            for item in data["RelatedTopics"]:
                if isinstance(item, dict) and item.get("Text"):
                    summary = item["Text"].strip()
                    break
    except Exception:
        summary = ""

    entry = {
        "query": clean_q,
        "summary": clean_readable_text(summary, preserve_math=True),
        "source_name": source_name,
        "ai_mode_url": ai_mode_url,
    }
    memory["searches"][search_key] = entry
    save_google_memory(memory)

    result = dict(entry)
    result["from_memory"] = False
    return result


def format_google_ai_mode_reply(ai_ctx: dict) -> str:
    mem_tag = " *(from search memory)*" if ai_ctx.get("from_memory") else ""
    ai_url = ai_ctx.get("ai_mode_url") or build_google_ai_mode_url(ai_ctx["query"])
    if ai_ctx.get("summary"):
        return (
            f"**Google AI Mode{mem_tag}:**\n\n"
            f"{ai_ctx['summary']}\n\n"
            f"[Google Ai mode]({ai_url})"
        )
    return (
        f"**Google AI Mode** for **{ai_ctx['query']}**{mem_tag} — "
        f"[Google Ai mode]({ai_url})"
    )


def answer_locally_from_chunks(question: str, matches: list) -> tuple[str, bool]:
    if not matches or matches[0]["score"] < 0.12:
        return "There's no results in the pdf, refer Google Ai mode futher", True

    stopwords = {
        "what", "who", "when", "where", "why", "how", "is", "are", "the",
        "and", "for", "from", "with", "that", "this", "into", "your"
    }
    keywords = {
        w.lower()
        for w in re.findall(r"[A-Za-z0-9]+", question)
        if len(w) > 2 and w.lower() not in stopwords
    }

    picked = []
    for m in matches[:3]:
        clean_chunk = clean_readable_text(m["text"], preserve_math=True)
        sentences = re.split(r"(?<=[.!?])\s+", clean_chunk)
        scored_sents = []
        for s in sentences:
            s_clean = clean_readable_text(s, preserve_math=True)
            words_in_s = re.findall(r"[A-Za-z0-9τθαβγδελμωπφρσΩ]+", s_clean)
            if len(s_clean) < 10 or len(words_in_s) < 3:
                continue
            s_words = {w.lower() for w in words_in_s}
            overlap = len(keywords & s_words)
            scored_sents.append((overlap, s_clean))

        scored_sents.sort(key=lambda item: item[0], reverse=True)
        best_lines = [line for score, line in scored_sents[:2] if score > 0] or [
            line for _, line in scored_sents[:1]
        ]
        if best_lines:
            picked.append(f"- **Page {m['page']} (Chunk #{m['chunk_id']}):** " + " ".join(best_lines))

    if not picked:
        return "There's no results in the pdf, refer Google Ai mode futher", True

    return (
        "**Notes Chunks Summary** — based strictly on your retrieved PDF chunks:\n\n"
        + "\n".join(picked),
        False,
    )


def build_rag_messages(question, matches):
    context_blocks = [
        f"[Excerpt {i} | Page {m['page']} | Chunk #{m['chunk_id']}]\n{clean_readable_text(m['text'], preserve_math=True)}"
        for i, m in enumerate(matches, start=1)
    ]
    context_text = "\n\n---\n\n".join(context_blocks)

    system_prompt = (
        "You are a study assistant answering questions from a student's uploaded PDF notes. "
        "Answer ONLY from the provided context excerpts. Cite page numbers in parentheses like (Page 84). "
        "Output clean, human-readable text with clear math symbols and formulas."
    )
    user_prompt = f"Context:\n{context_text}\n\nQuestion: {question}"
    return [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": user_prompt},
    ]


def answer_with_ollama(question, matches, api_key, model="gemma4:31b"):
    payload = {
        "model": model.strip(),
        "messages": build_rag_messages(question, matches),
        "stream": False,
    }
    req = urllib.request.Request(
        "https://ollama.com/api/chat",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key.strip()}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {exc.code}: {body}") from exc

    return clean_readable_text(data.get("message", {}).get("content", ""), preserve_math=True)


